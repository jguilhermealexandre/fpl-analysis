{
  "name": "easyfpl",
  "private": true,
  "description": "EasyFPL \u2014 static FPL analysis site. No bundler by design; see eslint.config.js.",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint scripts tools tests workers functions",
    "check:globals": "node tools/check-globals.mjs",
    "check:versions": "node tools/check-versions.mjs",
    "check:bump": "node tools/check-version-bump.mjs",
    "check:inline": "node tools/check-inline-syntax.mjs",
    "check:css": "node tools/check-inline-css.mjs",
    "check:preload": "node tools/check-preload.mjs",
    "gen:globals": "node tools/gen-eslint-globals.mjs",
    "stamp": "node tools/stamp-version.mjs",
    "log": "git log --oneline --invert-grep --grep='^Update FPL data' --grep='^Refresh live FPL data'",
    "check": "npm run lint && npm run check:globals && npm run check:gen && npm run check:min && npm run check:versions && npm run check:bump && npm run check:tracking && npm run check:inline && npm run check:css && npm run check:preload && npm run check:appcss && npm run check:og && npm run check:social && npm test",
    "check:sri": "node tools/check-sri.mjs",
    "check:photos": "node tools/check-player-photos.mjs",
    "check:gen": "node tools/check-gen-globals.mjs",
    "check:appcss": "node tools/check-app-css.mjs",
    "check:og": "node tools/make-og-cards.mjs --check",
    "check:social": "node tools/social-meta.mjs --check",
    "og:cards": "node tools/make-og-cards.mjs",
    "fonts": "node tools/fetch-fonts.mjs",
    "rerender:articles": "node tools/rerender-articles.mjs",
    "build": "node tools/minify.mjs",
    "check:min": "node tools/minify.mjs --check",
    "encode:shots": "node tools/encode-lp-shots.mjs",
    "gen:tracking": "node tools/gen-tracking.mjs",
    "check:tracking": "node tools/gen-tracking.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "lightningcss": "^1.33.0",
    "sharp": "^0.35.4"
  }
}
