# Line endings are normalised on commit. Six files were CRLF and one was mixed,
# which made any tool that writes LF produce a whole-file diff — a 338-line CSS
# deletion once showed up as 3,506 changed lines.
* text=auto eol=lf

*.png binary
*.jpg binary
*.webp binary
*.ico binary

# Generated feeds. Marking them keeps `git diff` and review focused on code.
data/players-data.json  -diff linguist-generated
data/bootstrap-static.json -diff linguist-generated
data/fixtures.json      -diff linguist-generated
data/event-live.json    -diff linguist-generated
data/articles/*.json    -diff linguist-generated
articles/*.html         linguist-generated
